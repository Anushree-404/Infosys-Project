// Prisma Schema - AI Irrigation Management System Phase 2
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  FARMER
  ADMIN
}

enum Language {
  ENGLISH
  HINDI
  TELUGU
  TAMIL
  KANNADA
  MARATHI
  GUJARATI
  PUNJABI
  BENGALI
  ODIA
}

enum SensorType {
  SOIL_MOISTURE
  TEMPERATURE
  HUMIDITY
  RAINFALL
  FLOW_METER
  PH_SENSOR
  NPK_SENSOR
  WATER_LEVEL
}

enum SensorStatus {
  ACTIVE
  INACTIVE
  FAULTY
  MAINTENANCE
}

enum FieldStatus {
  ACTIVE
  INACTIVE
  FALLOW
}

enum CropStatus {
  PLANNED
  GROWING
  HARVESTED
  FAILED
}

enum GrowthStage {
  SEEDLING
  VEGETATIVE
  FLOWERING
  FRUITING
  MATURITY
  HARVESTING
}

enum IrrigationMethod {
  DRIP
  SPRINKLER
  FLOOD
  FURROW
  SUBSURFACE
  RAIN_FED
}

enum WaterSource {
  BOREWELL
  CANAL
  RIVER
  POND
  RAINWATER
  MUNICIPALITY
}

// ============================================================
// USER MODEL
// ============================================================

model User {
  id                String    @id @default(uuid())
  fullName          String    @map("full_name")
  email             String    @unique
  phone             String?   @unique
  passwordHash      String    @map("password_hash")
  role              Role      @default(FARMER)
  profilePhoto      String?   @map("profile_photo")
  state             String?
  district          String?
  preferredLanguage Language  @default(ENGLISH) @map("preferred_language")
  isEmailVerified   Boolean   @default(false) @map("is_email_verified")
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at")
  deletedAt         DateTime? @map("deleted_at")

  fields         Field[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  weatherCache   WeatherCache[]
  notifications  Notification[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@map("users")
}

// ============================================================
// REFRESH TOKEN
// ============================================================

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime @map("expires_at")
  isRevoked  Boolean  @default(false) @map("is_revoked")
  deviceInfo String?  @map("device_info")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ============================================================
// PASSWORD RESET
// ============================================================

model PasswordReset {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@map("password_resets")
}

// ============================================================
// FIELD MODEL
// ============================================================

model Field {
  id               String           @id @default(uuid())
  name             String
  area             Float
  areaUnit         String           @default("acres") @map("area_unit")
  state            String?
  district         String?
  village          String?
  location         String?
  latitude         Float?
  longitude        Float?
  soilType         String?          @map("soil_type")
  irrigationMethod IrrigationMethod? @map("irrigation_method")
  waterSource      WaterSource?      @map("water_source")
  status           FieldStatus      @default(ACTIVE)
  description      String?
  userId           String           @map("user_id")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deletedAt        DateTime?        @map("deleted_at")

  crops            Crop[]
  sensors          Sensor[]
  weatherData      WeatherData[]
  fieldAssignments FieldAssignment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([state, district])
  @@map("fields")
}

// ============================================================
// CROP MODEL
// ============================================================

model Crop {
  id                    String      @id @default(uuid())
  name                  String
  variety               String?
  growthStage           GrowthStage @default(SEEDLING) @map("growth_stage")
  plantingDate          DateTime?   @map("planting_date")
  expectedHarvestDate   DateTime?   @map("expected_harvest_date")
  actualHarvestDate     DateTime?   @map("actual_harvest_date")
  expectedWaterReq      Float?      @map("expected_water_req") // litres/day
  currentStatus         CropStatus  @default(GROWING) @map("current_status")
  notes                 String?
  fieldId               String      @map("field_id")
  field                 Field       @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  deletedAt             DateTime?   @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([fieldId])
  @@index([currentStatus])
  @@map("crops")
}

// ============================================================
// SENSOR MODEL
// ============================================================

model Sensor {
  id               String       @id @default(uuid())
  name             String
  serialNumber     String       @unique @map("serial_number")
  type             SensorType
  status           SensorStatus @default(ACTIVE)
  location         String?
  batteryLevel     Float?       @map("battery_level")
  lastReading      DateTime?    @map("last_reading")
  installationDate DateTime?    @map("installation_date")
  fieldId          String       @map("field_id")
  field            Field        @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  deletedAt        DateTime?    @map("deleted_at")

  readings SensorReading[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([fieldId])
  @@index([type])
  @@index([status])
  @@index([serialNumber])
  @@map("sensors")
}

// ============================================================
// SENSOR READING MODEL
// ============================================================

model SensorReading {
  id             String   @id @default(uuid())
  sensorId       String   @map("sensor_id")
  sensor         Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  soilMoisture   Float?   @map("soil_moisture")  // percentage 0-100
  temperature    Float?                           // celsius
  humidity       Float?                           // percentage 0-100
  rainfall       Float?                           // mm
  waterLevel     Float?   @map("water_level")    // cm
  ph             Float?                           // 0-14
  nitrogen       Float?                           // ppm
  phosphorus     Float?                           // ppm
  potassium      Float?                           // ppm
  batteryLevel   Float?   @map("battery_level")  // percentage
  signalStrength Float?   @map("signal_strength") // dBm
  isValid        Boolean  @default(true) @map("is_valid")
  invalidReason  String?  @map("invalid_reason")
  source         String   @default("REST")        // REST | MQTT | TEST
  timestamp      DateTime @default(now())

  createdAt DateTime @default(now()) @map("created_at")

  @@index([sensorId])
  @@index([timestamp])
  @@index([sensorId, timestamp])
  @@map("sensor_readings")
}

// ============================================================
// WEATHER DATA MODEL
// ============================================================

model WeatherData {
  id              String   @id @default(uuid())
  fieldId         String   @map("field_id")
  field           Field    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  temperature     Float?
  feelsLike       Float?   @map("feels_like")
  humidity        Float?
  description     String?
  icon            String?
  windSpeed       Float?   @map("wind_speed")
  windDirection   Float?   @map("wind_direction")
  pressure        Float?
  visibility      Float?
  uvIndex         Float?   @map("uv_index")
  rainProbability Float?   @map("rain_probability")
  rainfall1h      Float?   @map("rainfall_1h")
  sunrise         DateTime?
  sunset          DateTime?
  location        String?
  country         String?
  forecastJson    Json?    @map("forecast_json")
  fetchedAt       DateTime @default(now()) @map("fetched_at")
  expiresAt       DateTime @map("expires_at")

  @@index([fieldId])
  @@index([fieldId, expiresAt])
  @@map("weather_data")
}

// ============================================================
// WEATHER CACHE (user-level, kept for dashboard)
// ============================================================

model WeatherCache {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location    String
  latitude    Float?
  longitude   Float?
  weatherData Json     @map("weather_data")
  fetchedAt   DateTime @default(now()) @map("fetched_at")
  expiresAt   DateTime @map("expires_at")

  @@index([userId])
  @@index([location])
  @@map("weather_cache")
}

// ============================================================
// NOTIFICATION MODEL
// ============================================================

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO | WARNING | ALERT | SUCCESS
  isRead    Boolean  @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

// ============================================================
// FIELD ASSIGNMENT (multi-farmer future support)
// ============================================================

model FieldAssignment {
  id         String    @id @default(uuid())
  fieldId    String    @map("field_id")
  field      Field     @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  assignedTo String    @map("assigned_to")
  role       String    @default("VIEWER")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  expiresAt  DateTime? @map("expires_at")

  @@unique([fieldId, assignedTo])
  @@index([fieldId])
  @@index([assignedTo])
  @@map("field_assignments")
}
