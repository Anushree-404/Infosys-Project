# ============================================================
# IrriSmart - AI Irrigation Management System
# Backend Environment Variables - Phase 2
# Copy this file to .env and fill in your values
# ============================================================

# Server
NODE_ENV=development
PORT=5000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/irrigation_db?schema=public"

# JWT Secrets — CHANGE THESE IN PRODUCTION
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email Service (Nodemailer — needed for password reset)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=noreply@irrismart.com

# Weather API — Get free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# MQTT Configuration (Phase 3)
# Set MQTT_ENABLED=true to activate real broker connection
MQTT_ENABLED=false
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Phase 3 — FastAPI ML Service
ML_SERVICE_URL=http://localhost:8000

# Frontend URL (for CORS & email links)
FRONTEND_URL=http://localhost:3000

# File Upload
UPLOAD_PATH=uploads/
MAX_FILE_SIZE=5242880

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
